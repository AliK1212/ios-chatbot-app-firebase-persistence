{
  "name": "safe-hmo-demo",
  "main": "expo-router/entry",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "set EXPO_NO_TELEMETRY=1&& expo start",
    "build:web": "expo export --platform web",
    "lint": "expo lint",
    "setup:openai": "node setup-openai.js",
    "set:openai-key": "node set-openai-key.js",
    "fix:openai-browser": "node fix-openai-browser.js",
    "setup:build": "node setup-build.js",
    "prebuild:ios": "set EAS_BUILD_PLATFORM=ios && node setup-build.js && npx expo prebuild --platform ios",
    "prebuild:android": "set EAS_BUILD_PLATFORM=android && node setup-build.js && npx expo prebuild --platform android",
    "postinstall": "node scripts/fix-firebase-pods.js && node scripts/fix-script-permissions.js",
    "fix:pods": "node scripts/clean-cocoapods-cache.js && node scripts/update-cocoapods-repos.js",
    "fix:pods:ios": "node scripts/fix-ios-pods.js",
    "fix:permissions": "node scripts/fix-script-permissions.js",
    "prepare:eas-build": "node scripts/prepare-eas-build.js",
    "doctor": "npx expo-doctor",
    "android": "expo run:android",
    "ios": "expo run:ios"
  },
  "react-dotenv": {
    "whitelist": [
      "OPENAI_API_KEY",
      "FIREBASE_API_KEY",
      "FIREBASE_AUTH_DOMAIN",
      "FIREBASE_PROJECT_ID",
      "FIREBASE_STORAGE_BUCKET",
      "FIREBASE_MESSAGING_SENDER_ID",
      "FIREBASE_APP_ID",
      "FIREBASE_MEASUREMENT_ID"
    ]
  },
  "dependencies": {
    "@expo-google-fonts/inter": "^0.2.3",
    "@expo/vector-icons": "^14.0.2",
    "@google/generative-ai": "^0.24.0",
    "@lucide/lab": "^0.1.2",
    "@react-native-async-storage/async-storage": "1.23.1",
    "@react-native-community/cli": "^13.6.0",
    "@react-native-community/hooks": "^100.1.0",
    "@react-native-community/netinfo": "^11.4.1",
    "@react-native-firebase/app": "^21.12.0",
    "@react-native-firebase/auth": "^21.12.0",
    "@react-native-masked-view/masked-view": "^0.3.2",
    "@react-navigation/bottom-tabs": "^7.2.0",
    "@react-navigation/native": "^7.0.14",
    "expo": "~52.0.38",
    "expo-blur": "^14.0.3",
    "expo-build-properties": "^0.13.2",
    "expo-clipboard": "^7.0.1",
    "expo-constants": "~17.0.8",
    "expo-document-picker": "~13.0.3",
    "expo-file-system": "~18.0.11",
    "expo-font": "~13.0.4",
    "expo-haptics": "^14.0.1",
    "expo-image": "~2.0.6",
    "expo-keep-awake": "^14.0.3",
    "expo-linear-gradient": "^14.0.2",
    "expo-linking": "^7.0.5",
    "expo-router": "~4.0.19",
    "expo-screen-capture": "^7.0.1",
    "expo-splash-screen": "~0.29.22",
    "expo-status-bar": "~2.0.1",
    "expo-symbols": "^0.2.2",
    "expo-system-ui": "^4.0.7",
    "expo-web-browser": "^14.0.2",
    "firebase": "^10.14.1",
    "lucide-react-native": "^0.475.0",
    "openai": "^4.87.3",
    "patch-package": "^8.0.0",
    "pdf-parse": "^1.1.1",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-dotenv": "^0.1.3",
    "react-native": "0.76.7",
    "react-native-chart-kit": "^6.12.0",
    "react-native-gesture-handler": "~2.20.2",
    "react-native-modal": "^13.0.1",
    "react-native-paper": "^5.13.1",
    "react-native-reanimated": "~3.16.1",
    "react-native-safe-area-context": "4.12.0",
    "react-native-screens": "~4.4.0",
    "react-native-svg": "15.8.0",
    "react-native-url-polyfill": "^2.0.0",
    "react-native-web": "^0.19.13",
    "react-native-webview": "13.12.5",
    "typescript": "^5.8.2"
  },
  "devDependencies": {
    "@babel/core": "^7.25.2",
    "@tsconfig/react-native": "^3.0.5",
    "@types/hammerjs": "^2.0.46",
    "@types/istanbul-lib-coverage": "^2.0.6",
    "@types/istanbul-lib-report": "^3.0.3",
    "@types/istanbul-reports": "^3.0.4",
    "@types/react": "~18.3.12"
  },
  "expo": {
    "doctor": {
      "reactNativeDirectoryCheck": {
        "exclude": [
          "react-native-chart-kit",
          "lucide-react-native"
        ],
        "listUnknownPackages": false
      }
    }
  }
}
